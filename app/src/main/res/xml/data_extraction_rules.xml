<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted database and Keystore-dependent security preferences from cloud backup -->
        <exclude domain="database" path="haykeye_database" />
        <exclude domain="sharedpref" path="haykeye_security_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted database and Keystore-dependent security preferences from device transfer -->
        <exclude domain="database" path="haykeye_database" />
        <exclude domain="sharedpref" path="haykeye_security_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
